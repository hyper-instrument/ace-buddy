# 飞书应用凭证（在 https://open.feishu.cn/app 创建应用后获取）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ace-buddy bridge 配置
# 设备连接方式（auto / serial / ble / none）
BUDDY_TRANSPORT=auto
BUDDY_BUDGET=200000

# （可选）预绑定飞书用户 open_id（不填则自动配对）
# BUDDY_FEISHU_USER_ID=ou_xxxxxxxxxxxxxxxx
